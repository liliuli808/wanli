# Server
PORT=8080
LOG_LEVEL=info

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wanli_db
DB_SSLMODE=disable

# Redis
# 注意：如果本地 6379 已被占用，可将本机 Redis 服务停止，或在 docker-compose.yml 中映射到 6380 并同步修改此处端口。
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

# Object Storage (MinIO / S3)
S3_ENDPOINT=127.0.0.1:9000
S3_PUBLIC_ENDPOINT=10.0.2.2:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=wanli-assets
S3_REGION=us-east-1
S3_USE_SSL=false
# 对外 URL（预签名上传/成品图地址）是否用 https；经 Cloudflare Tunnel 暴露时必须 true
S3_PUBLIC_USE_SSL=false

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=168

# Bilibili (optional; enables subtitle tracks visible only after login)
# Sensitive: paste the complete browser Cookie header only into your local .env.
BILIBILI_COOKIE=

# AI (阶段 1+ 使用)
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# === Turnstile 人机验证（注册/登录）===
# 开发可用官方测试 key：TURNSTILE_SITE_KEY=1x00000000000000000000AA（恒通过）
# TURNSTILE_SECRET_KEY 非空即可（测试 key 无匹配要求）；上线前到 Cloudflare 后台创建真实 widget
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 登录失败限流：连续失败 AUTH_MAX_FAILURES 次锁 AUTH_LOCKOUT_MINUTES 分钟
AUTH_MAX_FAILURES=5
AUTH_LOCKOUT_MINUTES=15
