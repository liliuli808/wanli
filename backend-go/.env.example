# Server
PORT=8080
LOG_LEVEL=info

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wanli_db
DB_SSLMODE=disable

# Redis
# 注意：如果本地 6379 已被占用，可将本机 Redis 服务停止，或在 docker-compose.yml 中映射到 6380 并同步修改此处端口。
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

# Object Storage (MinIO / S3)
S3_ENDPOINT=127.0.0.1:9000
S3_PUBLIC_ENDPOINT=10.0.2.2:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=wanli-assets
S3_REGION=us-east-1
S3_USE_SSL=false
# 对外 URL（预签名上传/成品图地址）是否用 https；经 Cloudflare Tunnel 暴露时必须 true
S3_PUBLIC_USE_SSL=false

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=168

# Bilibili (optional; enables subtitle tracks visible only after login)
# Sensitive: paste the complete browser Cookie header only into your local .env.
BILIBILI_COOKIE=
# Encrypts per-user SESSDATA authorized in the app. Leave empty to derive from JWT_SECRET.
BILIBILI_CREDENTIAL_ENC_KEY=

# AI (阶段 1+ 使用)
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# === Turnstile 人机验证（注册/登录）===
# 国内推广默认关闭：Turnstile 挑战域名在部分网络不可达，会导致登录/注册被硬阻断。
# 需要时设 TURNSTILE_ENABLED=true，并填下面两个 key（开发可用 1x00000000000000000000AA）。
# 注意：重新开启需要客户端同步恢复 Turnstile widget（当前 App 已移除，不再提交 token）。
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 登录失败限流：连续失败 AUTH_MAX_FAILURES 次锁 AUTH_LOCKOUT_MINUTES 分钟
AUTH_MAX_FAILURES=5
AUTH_LOCKOUT_MINUTES=15
# 注册限流：同一 IP 每小时最多注册次数（0 = 不限制）
AUTH_REGISTER_MAX_PER_HOUR=10
