# 碗里整机部署配置（docker compose 读取本文件做变量插值）
# 复制为 .env 后填写：cp .env.example .env

# === 必改：强随机值 ===
# 生成方式：openssl rand -base64 32
POSTGRES_PASSWORD=
MINIO_ROOT_USER=wanli
MINIO_ROOT_PASSWORD=
JWT_SECRET=

# === Cloudflare Tunnel（使用 --profile tunnel 时必填）===
TUNNEL_TOKEN=

# === 公网图片地址（成品图）===
# 未上 Tunnel 前保持默认；上线后改为 MinIO 的公网主机名（不带协议、不带端口）
S3_PUBLIC_ENDPOINT=127.0.0.1:9000
# 上 Tunnel 后必须改为 true（Cloudflare 只提供 https）
S3_PUBLIC_USE_SSL=false

# === AI 服务（DeepSeek，菜谱解析需要）===
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# === 可选 ===
# B 站 Cookie（登录后可见字幕轨）；注意值中的 $ 需写成 $$ 转义
BILIBILI_COOKIE=
# === Turnstile 人机验证（注册/登录）===
# 国内推广默认关闭：Turnstile 挑战域名在部分网络不可达，会导致登录/注册被硬阻断。
# 需要时设 TURNSTILE_ENABLED=true，并填下面两个 key（开发可用 1x00000000000000000000AA）。
# 注意：重新开启需要客户端同步恢复 Turnstile widget（当前 App 已移除，不再提交 token）。
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 登录失败限流：连续失败 AUTH_MAX_FAILURES 次锁 AUTH_LOCKOUT_MINUTES 分钟
AUTH_MAX_FAILURES=5
AUTH_LOCKOUT_MINUTES=15
# 注册限流：同一 IP 每小时最多注册次数（0 = 不限制）
AUTH_REGISTER_MAX_PER_HOUR=10
LOG_LEVEL=info
